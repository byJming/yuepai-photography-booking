page {
  --paper: #f7f3ed;
  --paper-light: #fffcf8;
  --ink: #292724;
  --muted: #77716a;
  --soft: #a59e96;
  --terracotta: #c96c56;
  --terracotta-light: #f0d6cd;
  --moss: #78816c;
  --line: #e7dfd5;
  --shadow: rgba(75, 59, 45, 0.08);
  min-height: 100%;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
image,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  line-height: normal;
  background: transparent;
  border-radius: 0;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 0 32rpx 176rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.page-subtitle {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.6;
}

.section-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 52rpx 0 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 650;
}

.section-note {
  color: var(--soft);
  font-size: 23rpx;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  color: #fffaf6;
  background: var(--terracotta);
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 16rpx 32rpx rgba(201, 108, 86, 0.18);
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  color: var(--terracotta);
  border: 2rpx solid var(--terracotta);
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.surface-card {
  background: var(--paper-light);
  border: 1rpx solid rgba(218, 207, 195, 0.78);
  border-radius: 16rpx;
  box-shadow: 0 16rpx 36rpx var(--shadow);
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 20rpx;
  color: var(--moss);
  background: #e8ece3;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
