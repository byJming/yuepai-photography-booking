root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true

[*.{py,ts,tsx,js,json,md,yml,yaml,toml,sql,conf,service,sh,ps1}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
[deploy/{scripts,systemd,nginx,logrotate,env}/**]
end_of_line = lf
