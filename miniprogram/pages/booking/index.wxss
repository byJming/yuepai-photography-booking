.booking-page {
  padding-top: 28rpx;
}

.booking-heading {
  padding: 8rpx 2rpx 20rpx;
}

.booking-kicker {
  display: block;
  margin-bottom: 12rpx;
  color: var(--terracotta);
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.booking-type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.booking-type-card {
  position: relative;
  min-height: 188rpx;
  padding: 26rpx 24rpx;
  background: var(--paper-light);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  box-shadow: 0 12rpx 30rpx var(--shadow);
}

.booking-type-mark {
  display: inline-flex;
  padding: 6rpx 12rpx;
  color: var(--moss);
  background: #e8ece3;
  border-radius: 999rpx;
  font-size: 18rpx;
}

.booking-type-name {
  margin-top: 22rpx;
  font-size: 29rpx;
  font-weight: 650;
}

.booking-type-note {
  margin-top: 10rpx;
  padding-right: 26rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.45;
}

.booking-type-arrow {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  color: var(--soft);
  font-size: 38rpx;
}

.process-card {
  display: flex;
  align-items: center;
  padding: 30rpx 18rpx;
}

.process-heading {
  margin-top: 44rpx;
}

.process-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.process-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  color: #fffaf6;
  background: var(--moss);
  border-radius: 50%;
  font-size: 20rpx;
  font-weight: 650;
}

.process-title {
  margin-top: 14rpx;
  font-size: 22rpx;
  font-weight: 620;
  white-space: nowrap;
}

.process-arrow {
  position: absolute;
  top: 11rpx;
  right: -13rpx;
  color: #c7beb4;
  font-size: 28rpx;
}

.policy-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 34rpx;
  padding: 26rpx 28rpx;
  background: #eee7dc;
  border-radius: 24rpx;
}

.policy-entry__title {
  font-size: 24rpx;
  font-weight: 620;
}

.policy-entry__note {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 19rpx;
}

.policy-entry__arrow {
  margin-left: 20rpx;
  color: var(--soft);
  font-size: 40rpx;
}

.booking-action {
  margin-top: 34rpx;
}

.booking-footnote {
  padding: 18rpx 20rpx 0;
  color: var(--soft);
  font-size: 21rpx;
  line-height: 1.55;
  text-align: center;
}

.booking-state {
  margin-top: 36rpx;
  padding: 42rpx 34rpx;
}

.booking-state {
  text-align: center;
}

.booking-state__title {
  font-size: 28rpx;
  font-weight: 650;
}

.booking-state__note {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.75;
}

.booking-state__action {
  width: 240rpx;
  margin-top: 26rpx;
  color: var(--terracotta);
  background: transparent;
  border: 1rpx solid var(--terracotta);
  border-radius: 999rpx;
  font-size: 24rpx;
}
