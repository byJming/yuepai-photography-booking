.profile-page {
  padding-top: 28rpx;
}

.profile-heading {
  padding: 12rpx 2rpx 30rpx;
}

.profile-kicker {
  display: block;
  margin-bottom: 12rpx;
  color: var(--moss);
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.booking-card {
  position: relative;
  display: flex;
  align-items: center;
  padding: 18rpx;
}

.booking-cover {
  width: 170rpx;
  height: 190rpx;
  border-radius: 22rpx;
}

.booking-content {
  flex: 1;
}

.booking-status-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.status-dot {
  width: 13rpx;
  height: 13rpx;
  background: var(--moss);
  border-radius: 50%;
  box-shadow: 0 0 0 7rpx rgba(120, 129, 108, 0.13);
}

.booking-status {
  color: var(--moss);
  font-size: 23rpx;
  font-weight: 620;
}

.booking-title {
  margin-top: 18rpx;
  font-size: 27rpx;
  font-weight: 650;
}

.booking-meta {
  margin-top: 9rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.booking-arrow {
  margin-right: 12rpx;
  color: var(--soft);
  font-size: 48rpx;
  font-weight: 300;
}

.profile-list {
  overflow: hidden;
  margin-top: 34rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 116rpx;
  padding: 20rpx 26rpx;
  border-bottom: 1rpx solid var(--line);
}

.profile-row:last-child {
  border-bottom: 0;
}

.profile-row__title {
  font-size: 26rpx;
  font-weight: 620;
}

.profile-row__note {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.profile-row__arrow {
  color: var(--soft);
  font-size: 42rpx;
}

.prototype-note {
  margin-top: 30rpx;
  padding: 30rpx;
  color: var(--muted);
  background: #eee7dc;
  border-radius: 24rpx;
}

.prototype-note__title {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 620;
}

.prototype-note__text {
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.6;
}

.booking-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.profile-state {
  padding: 52rpx 34rpx;
  text-align: center;
}

.profile-state__title {
  font-size: 28rpx;
  font-weight: 650;
}

.profile-state__note {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.65;
}

.profile-state__action {
  width: 240rpx;
  margin-top: 26rpx;
  color: var(--terracotta);
  background: transparent;
  border: 1rpx solid var(--terracotta);
  border-radius: 999rpx;
  font-size: 24rpx;
}

.copyright-notice {
  padding: 42rpx 0 24rpx;
  color: var(--soft);
  font-size: 18rpx;
  text-align: center;
}
