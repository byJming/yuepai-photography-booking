# 配置说明：
# 1. 微信配置修改 WECHAT_APP_ID / WECHAT_APP_SECRET；更换 AppID 时同步修改 project.config.json，随后重启宝塔项目 yuepai。
# 2. 管理后台账号、密码和动态验证码 Secret 不保存在 .env，而是加密/哈希存入 MySQL 的 admin_users 表。
# 3. 新建管理员：进入 backend 目录运行 /www/server/pyporject_evn/yuepai/bin/yuepai-create-admin；新账号默认不启用动态验证码，登录后台后可在“账户安全”扫码启用。
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8100
APP_LOG_LEVEL=INFO
APP_PUBLIC_BASE_URL=https://your-domain.example
ADMIN_PUBLIC_BASE_URL=https://your-domain.example/admin

MYSQL_DSN="mysql+pymysql://yuepai_example:URL_ENCODED_PASSWORD@127.0.0.1:3306/yuepai_example?charset=utf8mb4"
MYSQL_POOL_SIZE=3
MYSQL_MAX_OVERFLOW=2

REDIS_URL=redis://127.0.0.1:6379/2
REDIS_KEY_PREFIX=yuepai:prod

WECHAT_APP_ID=replace-after-registration
WECHAT_APP_SECRET=replace-after-registration
WECHAT_API_BASE_URL=https://api.weixin.qq.com

FIELD_ENCRYPTION_KEY_V1=replace-with-base64-32-byte-key
OPENID_HMAC_KEY=replace-with-at-least-32-random-bytes
SESSION_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
ADMIN_SESSION_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
ADMIN_COOKIE_NAME=yp_admin_session

MEDIA_PROVIDER=local
MEDIA_ROOT=/srv/example-app/media
MEDIA_PUBLIC_BASE_URL=https://your-domain.example/media/public
MEDIA_MAX_UPLOAD_BYTES=15728640
MEDIA_MAX_PIXELS=20000000
MEDIA_PROCESS_CONCURRENCY=1

SESSION_TTL_SECONDS=604800
ADMIN_SESSION_ABSOLUTE_TTL_SECONDS=28800
ADMIN_SESSION_IDLE_TTL_SECONDS=1800
ADMIN_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=[]
