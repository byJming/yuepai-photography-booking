.works-page {
  padding-top: 30rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 2rpx 28rpx;
}

.brand-eyebrow {
  display: block;
  margin-bottom: 8rpx;
  color: var(--soft);
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.availability-pill {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 10rpx;
  height: 58rpx;
  padding: 0 20rpx;
  color: var(--moss);
  background: rgba(232, 236, 227, 0.9);
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 550;
}

.availability-dot {
  width: 12rpx;
  height: 12rpx;
  background: var(--moss);
  border-radius: 50%;
  box-shadow: 0 0 0 7rpx rgba(120, 129, 108, 0.12);
}

.availability-pill--unavailable {
  color: var(--muted);
  background: #eee9e2;
}

.availability-pill--unavailable .availability-dot {
  background: var(--soft);
  box-shadow: none;
}

.hero-card {
  position: relative;
  height: 520rpx;
  overflow: hidden;
  border-radius: 34rpx;
  box-shadow: 0 24rpx 60rpx rgba(64, 48, 36, 0.16);
}

.hero-image,
.hero-shade {
  position: absolute;
  width: 100%;
  height: 100%;
}

.hero-shade {
  background: linear-gradient(180deg, rgba(25, 30, 31, 0.02) 22%, rgba(30, 28, 25, 0.7) 100%);
}

.hero-copy {
  position: absolute;
  right: 38rpx;
  bottom: 42rpx;
  left: 38rpx;
  display: flex;
  flex-direction: column;
  color: #fffdf9;
}

.hero-kicker {
  margin-bottom: 14rpx;
  font-size: 19rpx;
  letter-spacing: 3rpx;
  opacity: 0.82;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.hero-subtitle {
  width: 84%;
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.65;
  opacity: 0.9;
}

.hero-link {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
  font-size: 24rpx;
  font-weight: 550;
}

.hero-arrow {
  font-size: 32rpx;
}

.category-scroll {
  width: calc(100% + 64rpx);
  margin: 34rpx -32rpx 0;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 14rpx;
  padding: 0 32rpx 8rpx;
}

.category-item {
  display: flex;
  align-items: center;
  height: 62rpx;
  padding: 0 28rpx;
  color: var(--muted);
  background: rgba(255, 252, 248, 0.68);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  font-size: 24rpx;
}

.category-item--active {
  color: #fffaf6;
  background: var(--terracotta);
  border-color: var(--terracotta);
  box-shadow: 0 10rpx 24rpx rgba(201, 108, 86, 0.18);
}

.section-caption {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.portfolio-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.portfolio-card {
  position: relative;
  width: 100%;
  height: 350rpx;
  min-width: 0;
  overflow: hidden;
  border-radius: 26rpx;
  background: #ddd4c9;
}

.portfolio-image,
.portfolio-shade {
  position: absolute;
  width: 100%;
  height: 100%;
}

.portfolio-shade {
  background: linear-gradient(180deg, transparent 36%, rgba(31, 28, 25, 0.72) 100%);
}

.portfolio-meta {
  position: absolute;
  right: 22rpx;
  bottom: 24rpx;
  left: 22rpx;
  display: flex;
  flex-direction: column;
  color: #fffdf9;
}

.portfolio-tags {
  display: flex;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.portfolio-tag {
  padding: 5rpx 10rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  font-size: 17rpx;
  backdrop-filter: blur(8rpx);
}

.portfolio-title {
  font-size: 30rpx;
  font-weight: 650;
}

.portfolio-subtitle {
  margin-top: 7rpx;
  font-size: 21rpx;
  opacity: 0.82;
}

.empty-card {
  padding: 70rpx 30rpx;
  text-align: center;
}

.empty-mark {
  color: var(--terracotta);
  font-size: 54rpx;
}

.empty-title {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-note {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.story-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-top: 50rpx;
  padding: 44rpx 38rpx;
  background: #f1e8df;
}

.story-kicker {
  color: var(--terracotta);
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.story-title {
  margin-top: 18rpx;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.45;
}

.story-text {
  margin-top: 20rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.8;
}

.story-button {
  display: flex;
  align-items: center;
  align-self: flex-start;
  gap: 12rpx;
  margin: 30rpx 0 0;
  padding: 0;
  color: var(--terracotta);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.5;
}

.state-card {
  margin-top: 40rpx;
  padding: 72rpx 36rpx;
  text-align: center;
}

.state-title {
  font-size: 30rpx;
  font-weight: 650;
}

.state-note,
.loading-more {
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.state-action {
  width: 240rpx;
  margin-top: 28rpx;
  color: var(--terracotta);
  background: transparent;
  border: 1rpx solid var(--terracotta);
  border-radius: 999rpx;
  font-size: 24rpx;
}
