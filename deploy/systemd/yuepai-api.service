[Unit]
Description=Yuepai FastAPI Service
After=network-online.target mysqld.service redis.service
Wants=network-online.target

[Service]
Type=simple
User=yuepai
Group=yuepai
WorkingDirectory=/opt/example-app/current/backend
EnvironmentFile=/etc/example-app/yuepai.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/example-app/current/.venv/bin/uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8100 --workers 1 --limit-concurrency 64 --timeout-keep-alive 5 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/opt/example-app/shared /srv/example-app/media
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
