<view class="page-shell profile-page">
  <view class="profile-heading">
    <text class="profile-kicker">我的拍摄记录</text>
    <view class="page-title">我的预约</view>
    <view class="page-subtitle">在这里查看预约状态和下一步安排。</view>
  </view>

  <view class="section-header">
    <view class="section-title">最近预约</view>
    <text class="section-note">{{bookings.length}} 条</text>
  </view>

  <view wx:if="{{loading}}" class="profile-state surface-card">
    <view class="profile-state__title">正在加载预约记录</view>
    <view class="profile-state__note">首次进入会自动完成微信登录</view>
  </view>

  <view wx:elif="{{errorMessage}}" class="profile-state surface-card">
    <view class="profile-state__title">暂时无法加载</view>
    <view class="profile-state__note">{{errorMessage}}</view>
    <button class="profile-state__action" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:elif="{{bookings.length === 0}}" class="profile-state surface-card">
    <view class="profile-state__title">还没有预约记录</view>
    <view class="profile-state__note">选择喜欢的拍摄方向，提交第一条预约意向吧。</view>
    <button class="profile-state__action" bindtap="startBooking">开始预约</button>
  </view>

  <view wx:else class="booking-list">
    <view wx:for="{{bookings}}" wx:key="bookingNo" class="booking-card surface-card" data-booking-no="{{item.bookingNo}}" bindtap="openBooking">
      <view class="booking-content">
        <view class="booking-status-row"><view class="status-dot"></view><text class="booking-status">{{item.statusText}}</text></view>
        <view class="booking-title">{{item.title}}</view>
        <view class="booking-meta">{{item.dateText}}</view>
        <view class="booking-meta">预约编号：{{item.bookingNo}}</view>
      </view>
      <view class="booking-arrow">›</view>
    </view>
  </view>

  <view class="profile-list surface-card">
    <view class="profile-row" bindtap="openPolicies">
      <view><view class="profile-row__title">拍摄须知与隐私说明</view><view class="profile-row__note">服务范围、改期、信息使用和删除说明</view></view>
      <view class="profile-row__arrow">›</view>
    </view>
    <view class="profile-row" bindtap="startBooking">
      <view><view class="profile-row__title">再次预约</view><view class="profile-row__note">重新选择拍摄内容和时间</view></view>
      <view class="profile-row__arrow">›</view>
    </view>
    <view class="profile-row" bindtap="requestDeletion">
      <view><view class="profile-row__title">申请删除个人数据</view><view class="profile-row__note">提交后由摄影师核对并处理</view></view>
      <view class="profile-row__arrow">›</view>
    </view>
  </view>

  <view class="copyright-notice">小程序作者：© ming woqiang0610@163.com</view>
</view>
